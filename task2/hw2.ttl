@base <http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11/> .

<http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11#имеетПотомка
:имеетПотомка rdf:type owl:ObjectProperty ;
              owl:inverseOf :имеетПредка .


###  http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11#имеетПредка
:имеетПредка rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty .


###  http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11#имеетРебёнка
:имеетРебёнка rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :имеетПотомка ;
              owl:inverseOf :имеетРодителя .


###  http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11#имеетРодителя
:имеетРодителя rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :имеетПредка ;
               rdf:type owl:FunctionalProperty ,
                        owl:IrreflexiveProperty .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11#Человек
:Человек rdf:type owl:Class ;
         rdfs:subClassOf [ rdf:type owl:Restriction ;
                           owl:onProperty :имеетРодителя ;
                           owl:someValuesFrom :Человек
                         ] .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11#Анна
:Анна rdf:type owl:NamedIndividual ,
               :Человек ;
      :имеетРодителя :Иванн .


###  http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11#Иванн
:Иванн rdf:type owl:NamedIndividual ,
                :Человек ;
       :имеетРодителя :Мария .


###  http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11#Мария
:Мария rdf:type owl:NamedIndividual ,
                :Человек ;
       :имеетРодителя :Пётр .


###  http://www.semanticweb.org/artem/ontologies/2025/10/untitled-ontology-11#Пётр
:Пётр rdf:type owl:NamedIndividual .


